{
  "name": "octaai-firefox-addon",
  "version": "0.1.0",
  "description": "Firefox extension for OctaAI agent automation",
  "main": "dist/background/background.js",
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "start": "web-ext run --source-dir dist --browser-console",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "package": "web-ext build --source-dir dist --filename octaai-addon.xpi",
    "clean": "rm -rf dist/*"
  },
  "keywords": [
    "octaai",
    "automation",
    "browser",
    "firefox"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@webpack-cli/serve": "^1.7.0",
    "copy-webpack-plugin": "^11.0.0",
    "eslint": "^8.45.0",
    "web-ext": "^7.6.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {}
}
